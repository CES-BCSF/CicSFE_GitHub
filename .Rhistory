## INFORMACION ESPECIFICA ####
base::rm(list = base::ls()); grDevices::graphics.off() # BORRA ENVIRONMENT Y PLOTS
base::message("\033[92mINICIO DE CARGA DEL INPUT\033[39m\n")
titulo <- "Tasa de despidos en el sector privado registrado"
z_alcance <- "Aglomerado Gran Rosario"
z_descripcion <- "La serie refiere a la tasa de despidos en el sector privado registrado del aglomerado Gran Rosario, en empresas de 10 o más trabajadores. Se calcula como el porcentaje de despidos en el mes corriente en relación al empleo total del mes inmediato anterior. Excluye despidos con causa y aquellos asociados a la finalización de contratos por tiempo determinado."
um <- "Porcentaje de despidos en relación al empleo total"
fuente <- "Ministerio de Capital Humano"
inicio <- base::c(2005,01) # INICIO SERIE AA-MM
z_inicio_dias <- "2005-01-01" # INICIO SERIE AA-MM-DD
fin <- base::c(2030,12) # FIN INPUT CONSIDERANDO NAS
z_fin_dias <- "2030-12-31" # INICIO SERIE AA-MM-DD
z_codigo <- "GR-TD"
z_carpeta <- "Empleo" # CARPETA DEL ARCHIVO
z_sector <- "Mercado de trabajo" # PARA CLASIFICAR POR GRUPO
# CALIBRACION ESPECIFICA
## AJUSTE ESTACIONAL
correr_desde_span <- "2005.01," # INICIO DE LA SERIE
modelar_desde_model.span <- "2010.01," # INICIO DEL MODELADO
ae_metodo  <- "X11" # METODO DE DESCOMPOSICION | USAR "X11" O "SEATS"
niv_sin_hystory <- "OFF" # SI "ON" ENTONCES X11 CORRE UN CODIGO REDUCIDO SIN LINEAS VINCULADAS A HISTORY PARA EVITAR ERRORES
## SUAVIZADO SERIE FINAL
PM <- "PM 2x2" # USAR: "PM 2x2", "PM 3x5", "Sin suavizado"
## GIROS Y REFERENCIA PLOT 11
giros <- 0.03 # CALIBRAR | PROPORCION DEL NIVEL DE LA SERIE FILTRADA EN PORCENTAJE
giros_fechas <- 0.09 # CALIBRAR | PROPORCION DEL NIVEL DE LA SERIE FILTRADA EN PORCENTAJE
etiqueta_ciclo_referencia <- 0.8 # CALIBRAR | POSICION DE EQUIQUETA CICLO DE REFERENCIA
## LEYENDAS PLOTS 1-11 | PLOT 10 NO TIENE
leyenda_p1 <- "topright"
leyenda_p2 <- "topright"
leyenda_p3 <- "topright"
leyenda_p4 <- "topright"
leyenda_p5 <- "topright"
leyenda_p6 <- "bottomleft"
leyenda_p7 <- "bottomright"
leyenda_p8 <- "bottomleft"
leyenda_p9 <- "topleft"
leyenda_p11 <- "topright"
## DATOS BRUTOS ####
# IMPORTA DATOS DESDE DATASFE
input_df <- readxl::read_excel("C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/Data_SFE.xlsx",
sheet = "OUTM",
range = "CG190:CG501",
col_names = FALSE)
base::names(input_df) <- base::c("transformada")
# << R-CORE >> ####
base::source("C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/_R-Scripts/R-CORE.R")
# << GRAFICAS Y TESTS >> ####
base::source("C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/_R-Scripts/GRAPHICS&TESTS.R")
# << OUTPUT >> ####
base::source("C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/_R-Scripts/OUTPUT.R")
