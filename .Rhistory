titulo <- "Recursos tributarios de origen nacional (Coparticipación)"
z_alcance <- "Provincia de Santa Fe"
z_descripcion <- "La serie refiere a los recursos tributarios con que cuenta la provincia de Santa Fe transferidos en concepto de coparticipación nacional. Desde enero de 1992 hasta diciembre de 2000, los datos fueron mensualizados con información anual proveniente de la Secretaría de Haciendia, perteneciente al Ministerio de Economía de la Nación (MECON). La información publicada en miles de pesos corrientes es deflactada utilizando IPC-SFE-CON-ARG."
um  <- "Millones de pesos de 1993"
fuente <- "Ministerio de Economía de la Nación (MECON)"
inicio <- base::c(1992,01) # INICIO SERIE AA-MM
