titulo <- "Ventas en supermercados de gran superficie"
z_alcance <- "Santa Fe"
z_descripcion <- "La serie refleja la evolución mensual de las ventas nominales correspondientes a las bocas de expendio captadas por la encuesta de supermercados para la provincia de Santa Fe en salones cuya superficie es igual o superior a los 200 m2. Las cifras se deflactan por el Índice de Precios Implícitos (IPI), desde enero de 1997 hasta abril de 2007. Luego se aplican las tasas de cambio del Índice de Precios al Consumidor de la provincia de Santa Fe (IPC-SFE) y a partir de enero de 2012 se utilizan las tasas del IPC Congreso (IPC-CON). En la actualidad se ajusta por IPC Nacional a nivel general publicado por el INDEC (IPC-NAC) desde junio de 2017."
um  <- "Millones de pesos de 1993"
fuente <- "Instituto Nacional de Estadísticas y Censos (INDEC)"
inicio <- base::c(1997,01) # INICIO SERIE AA-MM
z_inicio_dias <- "1997-01-01" # INICIO SERIE AA-MM-DD
fin <- base::c(2030,12) # FIN INPUT CONSIDERANDO NAS
z_fin_dias <- "2030-12-31" # INICIO SERIE AA-MM-DD
z_codigo <- "SFE-VTS"
z_carpeta <- "Ventas" # CARPETA DEL ARCHIVO
z_sector <- "Consumo minorista" # PARA CLASIFICAR POR GRUPO
# CALIBRACION ESPECIFICA
## AJUSTE ESTACIONAL
correr_desde_span <- "1997.01," # INICIO DE LA SERIE
modelar_desde_model.span <- "2010.01," # INICIO DEL MODELADO
ae_metodo  <- "X11" # METODO DE DESCOMPOSICION | USAR "X11" O "SEATS"
niv_sin_hystory <- "OFF" # SI "ON" ENTONCES X11 CORRE UN CODIGO REDUCIDO SIN LINEAS VINCULADAS A HISTORY PARA EVITAR ERRORES
## SUAVIZADO SERIE FINAL
PM <- "PM 2x2" # USAR: "PM 2x2", "PM 3x5", "Sin suavizado"
## GIROS Y REFERENCIA PLOT 11
giros <- 0.015 # CALIBRAR | PROPORCION DEL NIVEL DE LA SERIE FILTRADA EN PORCENTAJE
giros_fechas <- 0.05 # CALIBRAR | PROPORCION DEL NIVEL DE LA SERIE FILTRADA EN PORCENTAJE
etiqueta_ciclo_referencia <- 0.8 # CALIBRAR | POSICION DE EQUIQUETA CICLO DE REFERENCIA
## LEYENDAS PLOTS 1-11 | PLOT 10 NO TIENE
leyenda_p1 <- "bottomright"
leyenda_p2 <- "bottomright"
leyenda_p3 <- "bottomright"
leyenda_p4 <- "bottomright"
leyenda_p5 <- "bottomright"
leyenda_p6 <- "bottomright"
leyenda_p7 <- "topright"
leyenda_p8 <- "bottomright"
leyenda_p9 <- "bottomright"
leyenda_p11 <- "bottomright"
## DATOS BRUTOS ####
