## INFORMACION ESPECIFICA ####
base::rm(list = base::ls()); grDevices::graphics.off() # BORRA ENVIRONMENT Y PLOTS
base::message("\033[92mINICIO DE CARGA DEL INPUT\033[39m\n")
titulo <- "Rama Sustancias y Productos Químicos del IPIM, con ponderación Santa Fe"
z_alcance <- "Provincia de Santa Fe"
z_descripcion <- "A partir de la división “Sustancias y Productos Químicos” del IPIM en términos agregados, se incorpora la participación relativa de la provincia de Santa Fe en dicho sector, utilizando el ponderador derivado del Censo Nacional Económico 2004/05 según la metodología de la Federación Industrial de Santa Fe. De este modo, la serie representa la evolución de la actividad de la industria química en la provincia. Su construcción integra información sobre producción, utilización de insumos, consumo aparente, ventas en unidades físicas, horas trabajadas del personal involucrado en el proceso productivo y ventas a precios corrientes deflactadas."
um <- "Índice base 2004=100"
fuente <- "Instituto Nacional de Estadísticas y Censos (INDEC)"
inicio <- base::c(1994,01) # INICIO SERIE AA-MM
z_inicio_dias <- "1994-01-01" # INICIO SERIE AA-MM-DD
fin <- base::c(2030,12) # FIN INPUT CONSIDERANDO NAS
z_fin_dias <- "2030-12-31" # INICIO SERIE AA-MM-DD
z_codigo <- "SFE-QUIM"
z_carpeta <- "Industrias" # CARPETA DEL ARCHIVO
z_sector <- "Industria" # PARA CLASIFICAR POR GRUPO
# CALIBRACION ESPECIFICA
## AJUSTE ESTACIONAL
correr_desde_span <- "1994.01," # INICIO DE LA SERIE
modelar_desde_model.span <- "2010.01," # INICIO DEL MODELADO
ae_metodo  <- "X11" # METODO DE DESCOMPOSICION | USAR "X11" O "SEATS"
niv_sin_hystory <- "OFF" # SI "ON" ENTONCES X11 CORRE UN CODIGO REDUCIDO SIN LINEAS VINCULADAS A HISTORY PARA EVITAR ERRORES
## SUAVIZADO SERIE FINAL
PM <- "PM 2x2" # USAR: "PM 2x2", "PM 3x5", "Sin suavizado"
## GIROS Y REFERENCIA PLOT 11
giros <- 0.02 # CALIBRAR | PROPORCION DEL NIVEL DE LA SERIE FILTRADA EN PORCENTAJE
giros_fechas <- 0.055 # CALIBRAR | PROPORCION DEL NIVEL DE LA SERIE FILTRADA EN PORCENTAJE
etiqueta_ciclo_referencia <- 1.5 # CALIBRAR | POSICION DE EQUIQUETA CICLO DE REFERENCIA
## LEYENDAS PLOTS 1-11 | PLOT 10 NO TIENE
leyenda_p1 <- "topleft"
leyenda_p2 <- "topleft"
leyenda_p3 <- "topleft"
leyenda_p4 <- "topleft"
leyenda_p5 <- "topleft"
leyenda_p6 <- "bottomleft"
leyenda_p7 <- "topleft"
leyenda_p8 <- "bottom"
leyenda_p9 <- "topleft"
leyenda_p11 <- "topleft"
## DATOS BRUTOS ####
# IMPORTA DATOS DESDE DATASFE
input_df <- readxl::read_excel("C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/Data_SFE.xlsx",
sheet = "OUTM",
range = "EV58:EV501",
col_names = FALSE)
base::names(input_df) <- base::c("transformada")
# << R-CORE >> ####
base::source("C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/_R-Scripts/R-CORE.R")
