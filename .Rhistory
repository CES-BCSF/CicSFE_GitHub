fuente <- "Instituto Nacional de Estadísticas y Censos (INDEC)"
inicio <- base::c(1991,01) # INICIO SERIE AA-MM
z_inicio_dias <- "1991-01-01" # INICIO SERIE AA-MM-DD
fin <- base::c(2030,12) # FIN INPUT CONSIDERANDO NAS
z_fin_dias <- "2030-12-31" # INICIO SERIE AA-MM-DD
z_codigo <- "SFE-SUP"
z_carpeta <- "Construc" # CARPETA DEL ARCHIVO
z_sector <- "Mercado inmobiliario y sector de la construcción" # PARA CLASIFICAR POR GRUPO
# CALIBRACION ESPECIFICA
## AJUSTE ESTACIONAL
correr_desde_span <- "1991.01," # INICIO DE LA SERIE
modelar_desde_model.span <- "2010.01," # INICIO DEL MODELADO
ae_metodo  <- "X11" # METODO DE DESCOMPOSICION | USAR "X11" O "SEATS"
niv_sin_hystory <- "OFF" # SI "ON" ENTONCES X11 CORRE UN CODIGO REDUCIDO SIN LINEAS VINCULADAS A HISTORY PARA EVITAR ERRORES
## SUAVIZADO SERIE FINAL
PM <- "PM 2x2" # USAR: "PM 2x2", "PM 3x5", "Sin suavizado"
## GIROS Y REFERENCIA PLOT 11
giros <- 0.025 # CALIBRAR | PROPORCION DEL NIVEL DE LA SERIE FILTRADA EN PORCENTAJE
giros_fechas <- 0.07 # CALIBRAR | PROPORCION DEL NIVEL DE LA SERIE FILTRADA EN PORCENTAJE
etiqueta_ciclo_referencia <- 1.1 # CALIBRAR | POSICION DE EQUIQUETA CICLO DE REFERENCIA
## LEYENDAS PLOTS 1-11 | PLOT 10 NO TIENE
leyenda_p1 <- "topleft"
leyenda_p2 <- "topleft"
leyenda_p3 <- "topleft"
leyenda_p4 <- "topleft"
leyenda_p5 <- "topleft"
leyenda_p6 <- "topright"
leyenda_p7 <- "top"
leyenda_p8 <- "bottom"
leyenda_p9 <- "top"
leyenda_p11 <- "bottomright"
## DATOS BRUTOS ####
