z_inicio_dias <- "2009-01-01" # INICIO SERIE AA-MM-DD
fin <- base::c(2030,12) # FIN INPUT CONSIDERANDO NAS
z_fin_dias <- "2030-12-31" # INICIO SERIE AA-MM-DD
z_codigo <- "GSF-TD"
z_carpeta <- "Empleo" # CARPETA DEL ARCHIVO
z_sector <- "Mercado de trabajo" # PARA CLASIFICAR POR GRUPO
# CALIBRACION ESPECIFICA
## AJUSTE ESTACIONAL
correr_desde_span <- "2009.01," # INICIO DE LA SERIE
modelar_desde_model.span <- "2010.01," # INICIO DEL MODELADO
ae_metodo  <- "X11" # METODO DE DESCOMPOSICION | USAR "X11" O "SEATS"
niv_sin_hystory <- "OFF" # SI "ON" ENTONCES X11 CORRE UN CODIGO REDUCIDO SIN LINEAS VINCULADAS A HISTORY PARA EVITAR ERRORES
## SUAVIZADO SERIE FINAL
PM <- "PM 2x2" # USAR: "PM 2x2", "PM 3x5", "Sin suavizado"
## GIROS Y REFERENCIA PLOT 11
giros <- 0.025 # CALIBRAR | PROPORCION DEL NIVEL DE LA SERIE FILTRADA EN PORCENTAJE
giros_fechas <- 0.08 # CALIBRAR | PROPORCION DEL NIVEL DE LA SERIE FILTRADA EN PORCENTAJE
etiqueta_ciclo_referencia <- 0.8 # CALIBRAR | POSICION DE EQUIQUETA CICLO DE REFERENCIA
## LEYENDAS PLOTS 1-11 | PLOT 10 NO TIENE
leyenda_p1 <- "topright"
leyenda_p2 <- "topright"
leyenda_p3 <- "topright"
leyenda_p4 <- "topright"
leyenda_p5 <- "topright"
leyenda_p6 <- "topleft"
leyenda_p7 <- "topleft"
leyenda_p8 <- "bottomright"
leyenda_p9 <- "topright"
leyenda_p11 <- "topright"
## DATOS BRUTOS ####
# IMPORTA DATOS DESDE DATASFE
input_df <- readxl::read_excel("C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/Data_SFE.xlsx",
sheet = "OUTM",
range = "CH238:CH501",
col_names = FALSE)
base::names(input_df) <- base::c("transformada")
# << R-CORE >> ####
base::source("C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/_R-Scripts/R-CORE.R")
# << GRAFICAS Y TESTS >> ####
base::source("C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/_R-Scripts/GRAPHICS&TESTS.R")
# << OUTPUT >> ####
base::source("C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/_R-Scripts/OUTPUT.R")
df <- readxl::read_excel("C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/IndComp/Complementos/Cointegración y ARDL/input_ARDL_29_9_26.xlsx",
sheet = "DATA",
range = "B2:J393", # JULIO DE 2026
col_names = TRUE)
## SE CONVIERTEN LAS SERIES A LOGARITMOS NEPERIANOS
ln_df <- base::log(df)
model_aic <- ARDL::auto_ardl(Y ~ X3, data = ln_df, max_order = base::c(12, 12), selection = "AIC")
model_bic <- ARDL::auto_ardl(Y ~ X3, data = ln_df, max_order = base::c(12, 12), selection = "BIC")
model_aic$top_orders[1, ]  # MEJOR ORDEN SEGUN AIC
model_bic$top_orders[1, ]  # MEJOR ORDEN SEGUN BIC
ardl_bm <- model_bic$best_model  # CRITERIO ADOPTADO: BIC
base::summary(ardl_bm)
# DIAGNOSTICO DE RESIDUOS
ardl_bm_lm <- ARDL::to_lm(ardl_bm)
lmtest::bgtest(ardl_bm_lm, order = 12)  # H0: SIN AUTOCORRELACION HASTA EL ORDEN 12
stats::acf(stats::residuals(ardl_bm), lag.max = 24)
# X1 MIDE EL EFECTO CONTEMPORANEO
# L(Y,1) CAPTA EL EFECTO DEL PRIMER REZAGO DE Y
# L(X1, 1) CAPTA EL EFECTO DE DEL PRIMER REZAGO DE X1 SOBRE Y
# output <- utils::capture.output(base::summary(ardl_bm))
#
# archivo_latex <- "t1_x8.tex"
#
# base::cat("\\section*{output}\n\n",
#           "\\begin{verbatim}\n",
#           base::paste(output, collapse = "\n"),
#           "\n\\end{verbatim}\n",
#           file = archivo_latex, sep = "")
# base::rm(output, archivo_latex)
impacto_CP <- ARDL::multipliers(ardl_bm, type = "sr") # EFECTO CONTEMPORANEO (BETA_0)
impacto_LP <- ARDL::multipliers(ardl_bm)              # EFECTO DE LARGO PLAZO | SUMA DE BETAS / (1 - SUMA DE PHIS), ECUACION (2)
impacto_LP
# MULTIPLICADORES DINAMICOS | HORIZONTE EXTENDIDO PARA VER LA CONVERGENCIA
impacto_n_periodos <- ARDL::multipliers(ardl_bm, type = 60)
mult_x <- impacto_n_periodos[["X3"]]  # CAMBIAR DE ACUERDO A VARIABLE
# TABLA PARA EL DOCUMENTO | HORIZONTES SELECCIONADOS
# DELAY = EFECTO MENSUAL (CAMBIO TRANSITORIO) | INTERIM = EFECTO ACUMULADO (CAMBIO PERMANENTE)
mult_x[1:20,]
mult_x[c(1,2,3,4,7,10,13),]
# mult_x[base::c(0, 1, 2, 3, 6, 9, 12) + 1, base::c("Delay", "Interim")]
mult_x[ base::which.max(mult_x[, 3]), ]
# MES EN QUE EL EFECTO ACUMULADO ALCANZA SU MAXIMO
base::which.max(mult_x[["Interim"]]) - 1
theta <- impacto_LP[impacto_LP$Term == "X3", "Estimate"]  # CAMBIAR DE ACUERDO A VARIABLE
# EFECTO ACUMULADO
graphics::par(mar = base::c(5, 5.5, 1.5, 1.5))
graphics::plot(0:60, mult_x[["Interim"]], type = "l", lwd = 3,
xlab = "Meses desde la variación (h)",
ylab = "Efecto acumulado sobre el ICA-SFE (%)",
cex.lab = 2, cex.axis = 2)
graphics::abline(h = theta, lty = 2, lwd = 2)
# EFECTO MARGINAL
graphics::par(mar = base::c(5, 5.5, 1.5, 1.5))
graphics::plot(0:60, mult_x[["Delay"]], type = "l", lwd = 3,
xlab = "Meses desde la variación (h)",
ylab = "Efecto marginal sobre el ICA-SFE (%)",
cex.lab = 2, cex.axis = 2)
graphics::abline(h = 0, lty = 2, lwd = 2)
# TEST DE BANDAS
ARDL::bounds_f_test(ardl_bm, case = 2)
btest <- ARDL::bounds_f_test(ardl_bm, case = 2)
btest[["p.value"]] # VALOR BAJO DE P AFIRMA COINTEGRACION DEL SISTEMA
ARDL::bounds_f_test(ardl_bm, case = 2, alpha = 0.05)$tab
# MODELO RECM
recm <-  ARDL::recm(ardl_bm, case = 2)
base::summary(recm)
ce <- ARDL::coint_eq(ardl_bm, case = 2)
ARDL::plot_lr(ardl_bm, ce, show.legend = TRUE)
ardl_bm_lm <- ARDL::to_lm(ardl_bm)
futuro <- stats::predict(ardl_bm_lm, h = 24)
ICA_SFE <- stats::ts(ln_df$Y)
FCT_12 <- stats::ts(futuro)
stats::ts.plot(ICA_SFE, FCT_12)
impacto_LP
impacto_CP
base::summary(ardl_bm)
(0.042972+0.068018-0.026234)/(1-1.774126+0.775974)
