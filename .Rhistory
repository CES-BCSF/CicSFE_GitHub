titulo <- "Remuneraciones reales brutas de asegurados en ARTs"
z_alcance <- "Provincia de Santa Fe"
z_descripcion <- "La serie refiere al total de remuneraciones brutas reales de asegurados en Aseguradoras de Riesgos del Trabajo (ART) en la provincia de Santa Fe, en función a la ubicación fiscal de la unidad productiva informante. La información es publicada en millones de pesos corrientes, que luego es deflactada por el Índice de Precios al Consumidor (IPC) de Santa Fe empalmado con el IPC nacional (nivel general)."
um <- "Millones de pesos de 1993"
fuente <- "Superintendencia de Riesgos del Trabajo. Gerencia Técnica. Departamento de Estudios Estadísticos."
inicio <- base::c(1996,07) # INICIO SERIE AA-MM
z_inicio_dias <- "1996-07-01" # INICIO SERIE AA-MM-DD
fin <- base::c(2030,12) # FIN INPUT CONSIDERANDO NAS
z_fin_dias <- "2030-12-31" # INICIO SERIE AA-MM-DD
z_codigo <- "SFE-ID"
z_carpeta <- "Empleo" # CARPETA DEL ARCHIVO
z_sector <- "Mercado de trabajo" # PARA CLASIFICAR POR GRUPO
# CALIBRACION ESPECIFICA
## AJUSTE ESTACIONAL
correr_desde_span <- "1996.07," # INICIO DE LA SERIE
modelar_desde_model.span <- "2010.01," # INICIO DEL MODELADO
ae_metodo  <- "X11" # METODO DE DESCOMPOSICION | USAR "X11" O "SEATS"
niv_sin_hystory <- "OFF" # SI "ON" ENTONCES X11 CORRE UN CODIGO REDUCIDO SIN LINEAS VINCULADAS A HISTORY PARA EVITAR ERRORES
## SUAVIZADO SERIE FINAL
PM <- "Sin suavizado" # USAR: "PM 2x2", "PM 3x5", "Sin suavizado"
## GIROS Y REFERENCIA PLOT 11
giros <- 0.02 # CALIBRAR | PROPORCION DEL NIVEL DE LA SERIE FILTRADA EN PORCENTAJE
giros_fechas <- 0.065 # CALIBRAR | PROPORCION DEL NIVEL DE LA SERIE FILTRADA EN PORCENTAJE
etiqueta_ciclo_referencia <- 0.8 # CALIBRAR | POSICION DE EQUIQUETA CICLO DE REFERENCIA
## LEYENDAS PLOTS 1-11 | PLOT 10 NO TIENE
leyenda_p1 <- "bottomright"
leyenda_p2 <- "bottomright"
leyenda_p3 <- "bottomright"
leyenda_p4 <- "bottomright"
leyenda_p5 <- "bottomright"
leyenda_p6 <- "bottomright"
leyenda_p7 <- "bottomleft"
leyenda_p8 <- "bottomright"
leyenda_p9 <- "bottomright"
leyenda_p11 <- "bottomright"
