}
bind_cols(
fecha = resp$documents$fecha,
as.data.frame(resp$documents$datos)
) |>
arrange(fecha)
}
# ── Descubrimiento ───────────────────────────────────────────────────
#' Lista los indicadores disponibles con su nombre legible.
listar_indicadores <- function() {
resp <- .ces_request("api", "colecciones") |>
.ces_perform("colecciones") |>
resp_body_json(simplifyVector = TRUE)
colecciones <- resp$colecciones
if (length(colecciones) == 0) {
cat("No hay indicadores disponibles.\n")
return(invisible(NULL))
}
nombres <- sapply(colecciones, function(col) {
cfg <- tryCatch(
.ces_request("api", "config", col) |> .ces_perform(col) |> resp_body_json(),
error = function(e) NULL
)
if (is.null(cfg)) col else (cfg$sheet_name %||% cfg$sheet_code %||% col)
})
df <- data.frame(collection = colecciones, nombre = unlist(nombres), row.names = NULL)
print(df)
invisible(df)
}
#' Muestra las columnas de un indicador: código, nombre, tipo y unidad.
ver_columnas <- function(codigo) {
collection <- .ces_collection(codigo)
cfg <- .ces_request("api", "config", collection) |> .ces_perform(collection) |> resp_body_json()
columns <- cfg$columns
if (length(columns) == 0) {
cat("No hay columnas configuradas para", collection, "\n")
return(invisible(NULL))
}
sheet <- cfg$sheet_name %||% collection
cat("Columnas de", sheet, paste0("(", collection, "):"), "\n")
for (codigo_col in names(columns)) {
col <- columns[[codigo_col]]
unidad <- if (!is.null(col$unit) && nchar(col$unit) > 0) paste0("  [", col$unit, "]") else ""
cat("  ", codigo_col, ": ", col$name, " (", col$type, ")", unidad, "\n", sep = "")
}
invisible(columns)
}
