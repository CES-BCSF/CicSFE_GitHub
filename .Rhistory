### MARGENES AGROPECUARIOS
# FUENTE COMPARTIDA: funcion que avisa al portal (ces-bcsf.github.io)
base::source("C:/_Sitio_GitHub/Github_main/ces-bcsf.github.io/scripts/actualizar_site_content.R")
# VARIABLES ####
path_anterior <- base::getwd()
archivo <- "RA_MA.html"
carpeta_origen <- "C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/_Reportes rmd/RA/Margenes_agropecuarios"
carpeta_destino <- "C:/_Sitio_GitHub/Github_main/ces-bcsf.github.io/web_ces/RA"
origen <- base::file.path(carpeta_origen, archivo)
destino <- base::file.path(carpeta_destino, archivo)
# SCRIPT PARA SUBIR EL ARCHIVO A GITHUB EN LA NUBE ####
## CAMBIO LA UBICACION BASE DE R PARA EJECUTAR DESDE LA CARPETA DE GITHUB
base::setwd("C:/_Sitio_GitHub/Github_main/ces-bcsf.github.io")
# TRAIGO LOS CAMBIOS DE GITHUB
gert::git_pull(repo = ".", remote = "origin", refspec = "main")
# ENVIA ARCHIVO DESDE LA CARPETA LOCAL A CARPETA GITHUB
#COPIA EL HTML DESDE ESTA CARPETA HACIA LA CARPETA QUE SE SUBIRA A GITHUB
base::file.copy(from = origen, to = destino, overwrite = TRUE)
#ESPERA 0.5 SEGUNDOS PARA QUE TERMINE DE GUARDAR EL ARCHIVO
base::Sys.sleep(0.5)
# PIDE AL USUARIO UN MENSAJE DE COMMIT PARA SUBIR A GITHUB
commit_message <- svDialogs::dlg_input(
"Ingresa tu mensaje de commit:",
base::paste0("Auto-update: RA_MA con datos actualizados al ", base::Sys.time())
)$res
#" SI EL USUARIO NO INGRESA NADA O CANCELA, SE USA UN MENSAJE POR DEFECTO
if (base::is.null(commit_message) || base::nchar(commit_message) == 0) {
commit_message <- base::paste("Auto-update: RA_MA con datos actualizados al ", base::Sys.time())
base::message("No se ingresó un mensaje. Usando el mensaje predeterminado: ", commit_message)
}
# EJECUTA EL COMANDO PARA SUBIR A GITHUB ####
gert::git_add(".")
gert::git_commit(commit_message)
gert::git_push(remote = "origin") # LA NUBE
base::message(paste0("Cambios en ",archivo, " subidos con Exito: "), commit_message)
actualizar_site_content(
categoria = "informes",
titulo = "Márgenes Agropecuarios",
item_url = "web_ces/RA/RA_MA.html"
)
base::setwd(path_anterior)
