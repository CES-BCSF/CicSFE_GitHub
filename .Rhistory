base::rm(list = base::ls()); grDevices::graphics.off() # BORRA ENVIRONMENT, PLOTS Y VIEWER
df <- readxl::read_excel("C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/IndComp/Complementos/Cointegración y ARDL/input_ARDL_29_9_26.xlsx",
sheet = "DATA",
range = "B2:J393", # JULIO DE 2026
col_names = TRUE)
## SE CONVIERTEN LAS SERIES A LOGARITMOS NEPERIANOS
ln_df <- base::log(df)
model_aic <- ARDL::auto_ardl(Y ~ X2, data = ln_df, max_order = base::c(12, 12), selection = "AIC")
model_bic <- ARDL::auto_ardl(Y ~ X2, data = ln_df, max_order = base::c(12, 12), selection = "BIC")
model_aic$top_orders[1, ]  # MEJOR ORDEN SEGUN AIC
model_bic$top_orders[1, ]  # MEJOR ORDEN SEGUN BIC
View(df)
model_aic$top_orders[1, ]  # MEJOR ORDEN SEGUN AIC
model_bic$top_orders[1, ]  # MEJOR ORDEN SEGUN BIC
ardl_bm <- model_bic$best_model  # CRITERIO ADOPTADO: BIC
base::summary(ardl_bm)
# DIAGNOSTICO DE RESIDUOS
ardl_bm_lm <- ARDL::to_lm(ardl_bm)
lmtest::bgtest(ardl_bm_lm, order = 12)  # H0: SIN AUTOCORRELACION HASTA EL ORDEN 12
stats::acf(stats::residuals(ardl_bm), lag.max = 24)
impacto_CP <- ARDL::multipliers(ardl_bm, type = "sr") # EFECTO CONTEMPORANEO (BETA_0)
impacto_LP <- ARDL::multipliers(ardl_bm)              # EFECTO DE LARGO PLAZO | SUMA DE BETAS / (1 - SUMA DE PHIS), ECUACION (2)
impacto_LP
# MULTIPLICADORES DINAMICOS | HORIZONTE EXTENDIDO PARA VER LA CONVERGENCIA
impacto_n_periodos <- ARDL::multipliers(ardl_bm, type = 60)
mult_x <- impacto_n_periodos[["X2"]]  # CAMBIAR DE ACUERDO A VARIABLE
# TABLA PARA EL DOCUMENTO | HORIZONTES SELECCIONADOS
# DELAY = EFECTO MENSUAL (CAMBIO TRANSITORIO) | INTERIM = EFECTO ACUMULADO (CAMBIO PERMANENTE)
mult_x[1:20,]
mult_x[c(1,2,3,6,9,12),]
mult_x[ base::which.max(mult_x[, 3]), ]
# MES EN QUE EL EFECTO ACUMULADO ALCANZA SU MAXIMO
base::which.max(mult_x[["Interim"]]) - 1
theta <- impacto_LP[impacto_LP$Term == "X2", "Estimate"]  # CAMBIAR DE ACUERDO A VARIABLE
# EFECTO ACUMULADO
graphics::par(mar = base::c(5, 5.5, 1.5, 1.5))
graphics::plot(0:60, mult_x[["Interim"]], type = "l", lwd = 3,
xlab = "Meses desde la variación (h)",
ylab = "Efecto acumulado sobre el ICA-SFE (%)",
cex.lab = 2, cex.axis = 2)
# MULTIPLICADORES DINAMICOS | HORIZONTE EXTENDIDO PARA VER LA CONVERGENCIA
impacto_n_periodos <- ARDL::multipliers(ardl_bm, type = 12)
mult_x <- impacto_n_periodos[["X2"]]  # CAMBIAR DE ACUERDO A VARIABLE
# TABLA PARA EL DOCUMENTO | HORIZONTES SELECCIONADOS
# DELAY = EFECTO MENSUAL (CAMBIO TRANSITORIO) | INTERIM = EFECTO ACUMULADO (CAMBIO PERMANENTE)
mult_x[1:20,]
mult_x[c(1,2,3,6,9,12),]
mult_x[ base::which.max(mult_x[, 3]), ]
# MES EN QUE EL EFECTO ACUMULADO ALCANZA SU MAXIMO
base::which.max(mult_x[["Interim"]]) - 1
theta <- impacto_LP[impacto_LP$Term == "X2", "Estimate"]  # CAMBIAR DE ACUERDO A VARIABLE
# EFECTO ACUMULADO
graphics::par(mar = base::c(5, 5.5, 1.5, 1.5))
graphics::plot(0:12, mult_x[["Interim"]], type = "l", lwd = 3,
xlab = "Meses desde la variación (h)",
ylab = "Efecto acumulado sobre el ICA-SFE (%)",
cex.lab = 2, cex.axis = 2)
graphics::abline(h = theta, lty = 2, lwd = 2)
# EFECTO MARGINAL
graphics::par(mar = base::c(5, 5.5, 1.5, 1.5))
graphics::plot(0:60, mult_x[["Delay"]], type = "l", lwd = 3,
xlab = "Meses desde la variación (h)",
ylab = "Efecto marginal sobre el ICA-SFE (%)",
cex.lab = 2, cex.axis = 2)
