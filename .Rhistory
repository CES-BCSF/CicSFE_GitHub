col_names = TRUE)
## SE CONVIERTEN LAS SERIES A LOGARITMOS NEPERIANOS
ln_df <- base::log(df)
model_aic <- ARDL::auto_ardl(Y ~ X3, data = ln_df, max_order = base::c(12, 12), selection = "AIC")
model_aic <- ARDL::auto_ardl(Y ~ X1, data = ln_df, max_order = base::c(12, 12), selection = "AIC")
model_bic <- ARDL::auto_ardl(Y ~ X1, data = ln_df, max_order = base::c(12, 12), selection = "BIC")
model_aic$top_orders[1, ]  # MEJOR ORDEN SEGUN AIC
model_bic$top_orders[1, ]  # MEJOR ORDEN SEGUN BIC
ardl_bm <- model_bic$best_model  # CRITERIO ADOPTADO: BIC
base::summary(ardl_bm)
# DIAGNOSTICO DE RESIDUOS
ardl_bm_lm <- ARDL::to_lm(ardl_bm)
lmtest::bgtest(ardl_bm_lm, order = 12)  # H0: SIN AUTOCORRELACION HASTA EL ORDEN 12
stats::acf(stats::residuals(ardl_bm), lag.max = 24)
(0.042972+0.068018-0.026234)/(1-1.774126+0.775974)
impacto_CP <- ARDL::multipliers(ardl_bm, type = "sr") # EFECTO CONTEMPORANEO (BETA_0)
impacto_LP <- ARDL::multipliers(ardl_bm)              # EFECTO DE LARGO PLAZO | SUMA DE BETAS / (1 - SUMA DE PHIS), ECUACION (2)
