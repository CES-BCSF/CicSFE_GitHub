# << INPUT >>
## INFORMACION ESPECIFICA ####
base::rm(list = base::ls()); grDevices::graphics.off() # BORRA ENVIRONMENT Y PLOTS
base::message("\033[92mINICIO DE CARGA DEL INPUT\033[39m\n")
titulo <- "Escrituras de ventas de la 2da circunscripción de Santa Fe"
z_alcance <- "Sur de la provincia de Santa Fe"
z_descripcion <- "La serie documenta el número de escrituras por ventas de propiedades otorgadas por escribanos de la segunda circunscripción del Colegio de Escribanos de la provincia. Abarca los departamentos del sur de Santa Fe. Se incluyen: venta, venta con reserva de usufructo, venta nuda propiedad, venta de partes indivisas, venta por tracto abreviado, entre otras."
um  <- "Número de escrituras"
fuente <- "Colegio de Escribanos de la segunda circunscripción de Santa Fe"
inicio <- base::c(2004,01) # INICIO SERIE AA-MM
z_inicio_dias <- "2004-01-01" # INICIO SERIE AA-MM-DD
fin <- base::c(2030,12) # FIN INPUT CONSIDERANDO NAS
z_fin_dias <- "2030-12-31" # INICIO SERIE AA-MM-DD
z_codigo <- "SFE-ESC2"
z_carpeta <- "Construc" # CARPETA DEL ARCHIVO
z_sector <- "Mercado inmobiliario y sector de la construcción" # PARA CLASIFICAR POR GRUPO
# CALIBRACION ESPECIFICA
## AJUSTE ESTACIONAL
correr_desde_span <- "2004.01," # INICIO DE LA SERIE
modelar_desde_model.span <- "2010.01," # INICIO DEL MODELADO
ae_metodo  <- "X11" # METODO DE DESCOMPOSICION | USAR "X11" O "SEATS"
niv_sin_hystory <- "OFF" # SI "ON" ENTONCES X11 CORRE UN CODIGO REDUCIDO SIN LINEAS VINCULADAS A HISTORY PARA EVITAR ERRORES
## SUAVIZADO SERIE FINAL
PM <- "PM 2x2" # USAR: "PM 2x2", "PM 3x5", "Sin suavizado"
## GIROS Y REFERENCIA PLOT 11
giros <- 0.03 # CALIBRAR | PROPORCION DEL NIVEL DE LA SERIE FILTRADA EN PORCENTAJE
giros_fechas <- 0.07 # CALIBRAR | PROPORCION DEL NIVEL DE LA SERIE FILTRADA EN PORCENTAJE
etiqueta_ciclo_referencia <- 0.8 # CALIBRAR | POSICION DE EQUIQUETA CICLO DE REFERENCIA
## LEYENDAS PLOTS 1-11 | PLOT 10 NO TIENE
leyenda_p1 <- "topright"
leyenda_p2 <- "topright"
leyenda_p3 <- "topright"
leyenda_p4 <- "topright"
leyenda_p5 <- "topright"
leyenda_p6 <- "bottomleft"
leyenda_p7 <- "bottomleft"
leyenda_p8 <- "topleft"
leyenda_p9 <- "topleft"
leyenda_p11 <- "bottomleft"
## DATOS BRUTOS ####
# IMPORTA DATOS DESDE DATASFE
input_df <- readxl::read_excel("C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/Data_SFE.xlsx",
sheet = "OUTM",
range = "BK178:BK501",
col_names = FALSE)
base::names(input_df) <- base::c("transformada")
# << R-CORE >> ####
base::source("C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/_R-Scripts/R-CORE.R")
# << GRAFICAS Y TESTS >> ####
base::source("C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/_R-Scripts/GRAPHICS&TESTS.R")
